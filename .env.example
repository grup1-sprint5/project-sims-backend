# Example environment file for local development
APP_NAME=ProjectSims
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_HOST_PORT=5433
DB_DATABASE=project_sims
DB_USERNAME=project_user
DB_PASSWORD=supersecret

# pgAdmin settings for local access
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Optional: change these if you map different host ports
PGADMIN_PORT=8080

# MongoDB settings
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=cluster-iot

# IoT microservice (FastAPI) base URL
# Used by Laravel as a proxy/bridge to show sensor data in the frontend.
# If FastAPI runs on the host machine, keep host.docker.internal and set the port.
IOT_MICROSERVICE_URL=http://host.docker.internal:8002
IOT_TIMEOUT=3

